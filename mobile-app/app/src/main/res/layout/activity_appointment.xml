<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:id="@+id/appointmentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="132dp">

        <LinearLayout
            android:id="@+id/appointmentsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="28dp"
            android:paddingEnd="22dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnPreviousMonth"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_appointment_arrow_button"
                            android:contentDescription="Mois précédent"
                            android:padding="9dp"
                            android:src="@drawable/ic_chevron_left_24" />

                        <TextView
                            android:id="@+id/tvAppointmentTitle"
                            style="@style/TextAppearance.MamaCarePlus.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:text="Mois"
                            android:textColor="@color/appointment_text"
                            android:textSize="26sp" />

                        <ImageButton
                            android:id="@+id/btnNextMonth"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_appointment_arrow_button"
                            android:contentDescription="Mois suivant"
                            android:padding="9dp"
                            android:src="@drawable/ic_chevron_right_24" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAppointmentMessage"
                        style="@style/TextAppearance.MamaCarePlus.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Chargement des rendez-vous..."
                        android:textColor="@color/appointment_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnListView"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:minHeight="40dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Vue liste"
                    android:textAllCaps="false"
                    android:textColor="@color/appointment_turquoise"
                    android:textSize="12sp"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/appointment_border"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/calendarCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_appointment_calendar_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="18dp"
                android:paddingEnd="8dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:id="@+id/dayHeaderRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextAppearance.MamaCarePlus.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="LUN"
                        android:textColor="@color/appointment_muted"
                        android:textSize="10sp" />

                    <TextView
                        style="@style/TextAppearance.MamaCarePlus.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="MAR"
                        android:textColor="@color/appointment_muted"
                        android:textSize="10sp" />

                    <TextView
                        style="@style/TextAppearance.MamaCarePlus.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="MER"
                        android:textColor="@color/appointment_muted"
                        android:textSize="10sp" />

                    <TextView
                        style="@style/TextAppearance.MamaCarePlus.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="JEU"
                        android:textColor="@color/appointment_muted"
                        android:textSize="10sp" />

                    <TextView
                        style="@style/TextAppearance.MamaCarePlus.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="VEN"
                        android:textColor="@color/appointment_muted"
                        android:textSize="10sp" />

                    <TextView
                        style="@style/TextAppearance.MamaCarePlus.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="SAM"
                        android:textColor="@color/appointment_muted"
                        android:textSize="10sp" />

                    <TextView
                        style="@style/TextAppearance.MamaCarePlus.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="DIM"
                        android:textColor="@color/appointment_muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/calendarGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSelectedDayTitle"
                style="@style/TextAppearance.MamaCarePlus.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Aujourd'hui"
                android:textColor="@color/appointment_text"
                android:textSize="22sp" />

            <LinearLayout
                android:id="@+id/listAppointments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:paddingBottom="18dp" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:elevation="8dp"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="22dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddAppointment"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:minHeight="54dp"
            android:text="Ajouter un rendez-vous"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/appointment_turquoise"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_calendar_24"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/white" />
    </LinearLayout>
</FrameLayout>
