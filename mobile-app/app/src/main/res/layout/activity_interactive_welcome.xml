<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_onboarding_gradient"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:minHeight="680dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="34dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/topLabel"
            style="@style/TextAppearance.MamaCarePlus.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_name" />

        <FrameLayout
            android:id="@+id/heroStage"
            android:layout_width="match_parent"
            android:layout_height="310dp"
            android:layout_marginTop="14dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.pfe.mamacareplus.ui.onboarding.HoldProgressCircleView
                android:id="@+id/heroCircle"
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:layout_gravity="center" />

            <View
                android:id="@+id/touchPulseRing"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:alpha="0.28"
                android:background="@drawable/bg_touch_pulse_ring" />

            <LinearLayout
                android:id="@+id/touchHintGroup"
                android:layout_width="126dp"
                android:layout_height="126dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_touch_hint_badge"
                android:clickable="true"
                android:elevation="8dp"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/heroIcon"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:contentDescription="@string/onboarding_circle_hint"
                    android:src="@drawable/ic_touch_hold_24" />

                <TextView
                    android:id="@+id/circleHint"
                    style="@style/TextAppearance.MamaCarePlus.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center"
                    android:text="@string/onboarding_circle_hint"
                    android:textColor="@color/primary_dark"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/contentGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.MamaCarePlus.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/onboarding_welcome_title"
                android:textSize="25sp" />

            <TextView
                style="@style/TextAppearance.MamaCarePlus.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/onboarding_welcome_subtitle"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.MamaCarePlus.Label"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_onboarding_feature_card"
                    android:gravity="center"
                    android:text="@string/onboarding_feature_tracking"
                    android:textColor="@color/dark_text"
                    android:textSize="11sp" />

                <TextView
                    style="@style/TextAppearance.MamaCarePlus.Label"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_onboarding_feature_card"
                    android:gravity="center"
                    android:text="@string/onboarding_feature_health"
                    android:textColor="@color/dark_text"
                    android:textSize="11sp" />

                <TextView
                    style="@style/TextAppearance.MamaCarePlus.Label"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_onboarding_feature_card"
                    android:gravity="center"
                    android:text="@string/onboarding_feature_baby"
                    android:textColor="@color/dark_text"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/holdHint"
            style="@style/TextAppearance.MamaCarePlus.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/onboarding_hold_button"
            android:textColor="@color/primary_dark"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
