<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/questionnaireContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="30dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btnQuestionnaireBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_circle_icon"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:padding="10dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Retour"
                    android:src="@drawable/ic_back_arrow"
                    app:tint="#D6336C" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvQuestionnaireTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:includeFontPadding="false"
                    android:letterSpacing="0"
                    android:text="Évaluation de santé"
                    android:textColor="#2D1B24"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvQuestionnaireMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:letterSpacing="0"
                    android:lineSpacingExtra="2dp"
                    android:text="Répondez doucement, une question à la fois."
                    android:textColor="#8A7180"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvProgressBadge"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_progress_badge"
                android:gravity="center"
                android:minWidth="56dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="0/0"
                android:textColor="#D6336C"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressQuestionnaire"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="18dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_progress_bar" />

        <LinearLayout
            android:id="@+id/listQuestionnaires"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="18dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/questionnaireBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_question_bottom_bar"
            android:elevation="3dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="10dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreviousQuestion"
                style="@style/Widget.MamaCarePlus.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Précédent"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_back_arrow"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconTint="#D6336C" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSkipQuestion"
                style="@style/Widget.MamaCarePlus.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Passer"
                android:visibility="gone"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextQuestion"
                style="@style/Widget.MamaCarePlus.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Suivant"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_arrow_right_24"
                app:iconGravity="textEnd"
                app:iconPadding="6dp"
                app:iconTint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
