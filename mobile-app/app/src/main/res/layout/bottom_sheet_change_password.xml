<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="18dp"
    android:paddingEnd="22dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_avatar_sheet_handle" />

    <TextView
        style="@style/TextAppearance.MamaCarePlus.SectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Modifier le mot de passe" />

    <TextView
        style="@style/TextAppearance.MamaCarePlus.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Modifiez votre mot de passe sans quitter votre session." />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCurrentPassword"
        style="@style/Widget.MamaCarePlus.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:hint="Mot de passe actuel"
        app:boxStrokeColor="#16B8C7"
        app:endIconMode="password_toggle"
        app:endIconTint="#16B8C7"
        app:startIconDrawable="@drawable/ic_lock_24"
        app:startIconTint="#16B8C7">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCurrentPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilNewPassword"
        style="@style/Widget.MamaCarePlus.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Nouveau mot de passe"
        app:boxStrokeColor="#16B8C7"
        app:endIconMode="password_toggle"
        app:endIconTint="#16B8C7"
        app:startIconDrawable="@drawable/ic_lock_24"
        app:startIconTint="#16B8C7">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNewPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilConfirmPassword"
        style="@style/Widget.MamaCarePlus.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Confirmer le nouveau mot de passe"
        app:boxStrokeColor="#16B8C7"
        app:endIconMode="password_toggle"
        app:endIconTint="#16B8C7"
        app:startIconDrawable="@drawable/ic_lock_24"
        app:startIconTint="#16B8C7">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvChangePasswordMessage"
        style="@style/TextAppearance.MamaCarePlus.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelChangePassword"
            style="@style/Widget.MamaCarePlus.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:text="Annuler"
            android:textColor="#16B8C7"
            app:strokeColor="#CFEFF2" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitChangePassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="#16B8C7"
                android:text="Enregistrer"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_check_circle_24"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="#FFFFFF" />

            <ProgressBar
                android:id="@+id/progressChangePassword"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminateTint="#FFFFFF"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
