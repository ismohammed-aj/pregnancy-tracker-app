<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient">

    <LinearLayout
        android:id="@+id/tasksContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_icon"
                android:contentDescription="@null"
                android:padding="12dp"
                android:src="@drawable/ic_task_24" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTasksTitle"
                    style="@style/TextAppearance.MamaCarePlus.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tâches de soin" />

                <TextView
                    android:id="@+id/tvTasksMessage"
                    style="@style/TextAppearance.MamaCarePlus.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Organisez vos rendez-vous, médicaments et soins quotidiens." />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvTaskOverview"
            style="@style/TextAppearance.MamaCarePlus.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_chip_soft"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:text="Synchronisation de votre liste..." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_rounded"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/TextAppearance.MamaCarePlus.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nouvelle tâche de soin" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTaskTitle"
                style="@style/Widget.MamaCarePlus.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Titre de la tâche">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTaskTitle"
                    style="@style/Widget.MamaCarePlus.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTaskDescription"
                style="@style/Widget.MamaCarePlus.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Description optionnelle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTaskDescription"
                    style="@style/Widget.MamaCarePlus.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTaskDueDate"
                    style="@style/Widget.MamaCarePlus.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="Date">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTaskDueDate"
                        style="@style/Widget.MamaCarePlus.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:inputType="none"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTaskDueTime"
                    style="@style/Widget.MamaCarePlus.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="Heure">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTaskDueTime"
                        style="@style/Widget.MamaCarePlus.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:inputType="none"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddTask"
                style="@style/Widget.MamaCarePlus.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Ajouter la tâche"
                app:icon="@drawable/ic_add_24"
                app:iconGravity="textStart" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.MamaCarePlus.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Aujourd'hui et à venir" />

        <LinearLayout
            android:id="@+id/stateContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_rounded"
            android:elevation="1dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="22dp">

            <ProgressBar
                android:id="@+id/progressState"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:indeterminateTint="@color/primary" />

            <ImageView
                android:id="@+id/ivStateIcon"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_circle_icon"
                android:contentDescription="@null"
                android:padding="11dp"
                android:src="@drawable/ic_task_24"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvStateTitle"
                style="@style/TextAppearance.MamaCarePlus.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Chargement des tâches" />

            <TextView
                android:id="@+id/tvStateMessage"
                style="@style/TextAppearance.MamaCarePlus.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:text="Veuillez patienter pendant la préparation de votre liste." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStateAction"
                style="@style/Widget.MamaCarePlus.Button.Outline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Réessayer"
                android:visibility="gone"
                app:icon="@drawable/ic_refresh_24"
                app:iconGravity="textStart" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/listTasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
