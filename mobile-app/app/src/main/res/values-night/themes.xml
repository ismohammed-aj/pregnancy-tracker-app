<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.MamaCarePlus" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/soft_accent</item>
        <item name="colorOnPrimaryContainer">@color/dark_text</item>
        <item name="colorSecondary">@color/primary_light</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/dark_text</item>
        <item name="colorSurfaceVariant">@color/soft_accent_light</item>
        <item name="colorOnSurfaceVariant">@color/secondary_text</item>
        <item name="android:textColorPrimary">@color/dark_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>

        <item name="materialButtonStyle">@style/Widget.MamaCarePlus.Button.Primary</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.MamaCarePlus.Button.Outline</item>
        <item name="textInputStyle">@style/Widget.MamaCarePlus.TextInputLayout</item>
    </style>

    <style name="Theme.MamaCarePlus" parent="Base.Theme.MamaCarePlus" />
</resources>
