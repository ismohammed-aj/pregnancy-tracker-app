<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.MamaCarePlus.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/dark_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.MamaCarePlus.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/dark_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.MamaCarePlus.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/dark_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.MamaCarePlus.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/secondary_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.MamaCarePlus.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.MamaCarePlus.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">40dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">11dp</item>
        <item name="iconTint">@color/white</item>
        <item name="rippleColor">@color/soft_accent</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.MamaCarePlus.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/card_background</item>
        <item name="cornerRadius">11dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/soft_accent</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="Widget.MamaCarePlus.Button.Module" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">70dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/card_background</item>
        <item name="cornerRadius">18dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/soft_accent</item>
        <item name="android:textColor">@color/dark_text</item>
    </style>

    <style name="Widget.MamaCarePlus.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/card_background</item>
        <item name="boxStrokeColor">@color/input_stroke_state</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintTextColor">@color/input_label_state</item>
        <item name="android:textColorHint">@color/input_placeholder</item>
        <item name="errorTextColor">@color/input_invalid</item>
        <item name="android:elevation">1dp</item>
    </style>

    <style name="Widget.MamaCarePlus.Input" parent="@android:style/Widget.EditText">
        <item name="android:background">@drawable/bg_input_rounded</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/input_text</item>
        <item name="android:textColorHint">@color/input_placeholder</item>
        <item name="android:textCursorDrawable">@drawable/bg_input_cursor</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:elevation">1dp</item>
    </style>

    <style name="Widget.MamaCarePlus.TextInputEditText" parent="@android:style/Widget.EditText">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textColor">@color/input_text</item>
        <item name="android:textColorHint">@color/input_placeholder</item>
        <item name="android:textCursorDrawable">@drawable/bg_input_cursor</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="ShapeAppearanceOverlay_MamaCarePlus_Circle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
